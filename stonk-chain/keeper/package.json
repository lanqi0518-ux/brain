{
    "name": "stockchain-keeper",
    "version": "0.1.0",
    "description": "Keeper service for the StockChain awareness layer — syncs uiMultiplier across chains and updates the UsdgPaymaster exchange rate.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "sync": "tsx src/multiplierSync.ts",
        "rate": "tsx src/paymasterRate.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "viem": "^2.21.0",
        "pino": "^9.5.0"
    },
    "devDependencies": {
        "@types/node": "^22.7.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
}
