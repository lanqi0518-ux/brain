# Copy to .env and fill in. Never commit .env.

# Deployer key (only for testnet / minimum-value mainnet deploys).
PRIVATE_KEY=

# RPC endpoints
ROBINHOOD_CHAIN_RPC=https://rpc.robinhood.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
MAINNET_RPC=https://ethereum-rpc.publicnode.com

# Ecosystem addresses on Robinhood Chain mainnet (fill after mapping)
UNISWAP_V4_POOL_MANAGER=
LIGHTER=
MORPHO_BLUE=
CROSS_CHAIN_MESSENGER=

# STONK admin — start with a Safe multisig, never an EOA in production.
STONK_ADMIN=
