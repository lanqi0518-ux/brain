# --- RPCs ----------------------------------------------------------------
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_CHAIN_RPC=
MAINNET_RPC=

# --- Deployer ------------------------------------------------------------
# Private key of the deploying EOA. Prefer a hardware-derived hot wallet
# used only for deployment; hand ownership to STONK_ADMIN afterwards.
DEPLOYER_PK=

# --- Admin ---------------------------------------------------------------
# The multisig (Safe) that will own every admin-scoped role after deploy.
# Never a plain EOA in production.
STONK_ADMIN=

# --- Protocol integrations ----------------------------------------------
# Uniswap V4 PoolManager
#   Arb Sepolia: 0xFB3e0C6F74eB1a21CC1Da29aeC80D2Dfe6C9a317
UNISWAP_V4_POOL_MANAGER=0xFB3e0C6F74eB1a21CC1Da29aeC80D2Dfe6C9a317

# Morpho Blue — leave zero until deployed on target chain
MORPHO_BLUE=0x0000000000000000000000000000000000000000

# Lighter perp DEX — leave zero until deployed on target chain
LIGHTER=0x0000000000000000000000000000000000000000

# Arbitrum Orbit L2->L3 messenger — leave zero for single-chain deploys
CROSS_CHAIN_MESSENGER=0x0000000000000000000000000000000000000000

# USDG stablecoin — mock on testnets, canonical on mainnet
USDG=

# Canonical ERC-4337 v0.7 EntryPoint (same address on all chains)
ENTRYPOINT_4337=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# --- Keeper (bridge sync + paymaster rate) ------------------------------
KEEPER_PK=
KEEPER_ETH_RPC=$ARB_SEPOLIA_RPC
KEEPER_L3_RPC=
KEEPER_PRICE_FEED=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
